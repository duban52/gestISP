# Entorno de PRUEBAS.
#
# Este archivo existe por una razón concreta: sin él, `php artisan
# <lo-que-sea> --env=testing` cae en .env y apunta a la base de
# DESARROLLO. phpunit.xml sí define gestisp_testing, pero eso solo
# aplica al ejecutar phpunit — no a los comandos de artisan.
#
# Esa diferencia costó una base de datos: un `migrate:fresh
# --env=testing` borró gestisp_db creyendo que tocaba gestisp_testing.
APP_ENV=testing
APP_KEY=base64:pFqOPLLGIYc3nvsVOBTC8XPFY3ppLg0Ku3hMBB0Qkl0=
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestisp_testing
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
